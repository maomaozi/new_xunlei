APP_ENV=development
APP_NAME=Xunlei Downloader API
APP_DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://127.0.0.1:5176","http://localhost:5176"]
# Persistent state: settings, Xunlei credentials and local transfer jobs.
DATA_DIR=data
# Serve the built frontend (frontend/dist) from the API process when present.
FRONTEND_DIST=../frontend/dist
# Start and supervise the bundled Xunlei download engine with the API process.
ENGINE_AUTOSTART=true
